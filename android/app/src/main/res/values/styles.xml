<resources>

    <!-- Theme of the Compose UI (ui.WlwdwActivity). Compose draws its own
         Material 3 surfaces and colours, so the only job left to the platform
         theme is to have no ActionBar and to paint the launch window (the frame
         before the first Compose composition) in the design's page colour.
         The parent is a framework theme rather than a Material Components one:
         that library belongs to the View system and this app no longer uses it.

         The dark variant lives in values-night/styles.xml. -->
    <style name="Theme.Wlwdw" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/wlwdw_page</item>
    </style>

</resources>
