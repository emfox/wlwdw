<?xml version="1.0" encoding="utf-8"?>
<!--
  Launcher icon, derived from the web app's favicon (public/favicon.png) so the
  app and the server share one mark. Generated by the icon script; the layers
  are bitmaps rather than vectors because the source is a bitmap.

  The pin is a tall shape on a near-square canvas, so it is sized to the
  launcher's mask (68dp of the 108dp canvas) rather than to the canvas; anything
  taller loses its tip under a circular mask.
-->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/ic_launcher_background" />
    <foreground android:drawable="@mipmap/ic_launcher_foreground" />
    <!-- Android 13+ themed icons: the launcher tints this layer, so it is a
         plain silhouette of the same pin with the pale disc punched out. -->
    <monochrome android:drawable="@mipmap/ic_launcher_monochrome" />
</adaptive-icon>
