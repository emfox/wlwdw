<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    android:versionCode="1"
    android:versionName="1.0">

    <!-- Location: the app is a tracker, so it needs a fix while the screen is
         off. ACCESS_BACKGROUND_LOCATION is requested at runtime (Android 10+)
         when the user starts continuous location. -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION" />
    <!-- Reaching the server (trail upload / message pull) and the MQTT broker
         over WSS. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- The one long-lived foreground service: the MQTT push link and, while it
         is switched on, the reporting loop. It is one service rather than two
         because a foreground service shows exactly one notification, and the
         two permanent notices were merged into one. FOREGROUND_SERVICE_DATA_SYNC
         is required since Android 14 (targetSdk 34) for a dataSync-type service,
         and FOREGROUND_SERVICE_LOCATION for the location type it claims while
         tracking. See the targetSdk note in app/build.gradle. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- To be told the phone has restarted, so that tracking can resume when the
         user has asked it to. Asking for the permission costs nothing; whether
         anything happens at boot is the "start on boot" setting, off by
         default. See BootReceiver. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:theme="@style/Theme.Wlwdw">

        <!-- The push link and the reporting loop, in one service, behind one
             permanent notification.

             Both types are declared because the service claims one or the other
             at runtime: `dataSync` always (the push link, which needs no
             permission), `location` added while tracking is on and the app holds
             a location permission. The runtime type must be a subset of what is
             declared here, and on targetSdk 34 it must not be NONE, so BOTH have
             to be listed and the choice cannot be left to the manifest alone.
             See WlwdwService for the rules.

             A process killed while it is up is restarted (START_STICKY) so that
             neither a report nor a message is silently lost; a service the user
             has stopped is gone for good, because stopping tracking is not the
             same as stopping the service. -->
        <service
            android:name=".service.WlwdwService"
            android:exported="false"
            android:foregroundServiceType="dataSync|location" />

        <!-- Restarts tracking after a reboot, if the user asked for that. It is
             exported because a broadcast from the system has to be able to
             reach it, and the only action it filters for,
             ACTION_BOOT_COMPLETED, is protected, so no other app can send it. -->
        <receiver
            android:name=".tracking.BootReceiver"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

        <!-- The single Activity; everything above it is Compose. -->
        <activity
            android:name=".ui.WlwdwActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.Wlwdw">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
