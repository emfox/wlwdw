<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    android:versionCode="1"
    android:versionName="1.0">

    <!-- Location: the app is a tracker, so it needs a fix while the screen is
         off. ACCESS_BACKGROUND_LOCATION is requested at runtime (Android 10+)
         when the user starts continuous location. -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION" />
    <!-- Reaching the server (trail upload / message pull) and the MQTT broker
         over WSS. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- The two long-lived foreground services: continuous location and MQTT
         push, plus the notifications they post. FOREGROUND_SERVICE_DATA_SYNC is
         required since Android 14 (targetSdk 34) for a dataSync-type service.
         See the targetSdk note in app/build.gradle. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.VIBRATE" />

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:theme="@style/Theme.Wlwdw">

        <!-- The MQTT push link. It keeps a connection to the broker and so has
             to be a foreground service: it runs while the app is not on screen,
             and Android only leaves a service alone under those conditions if
             the user can see that it is running. Type is dataSync, as it was
             before the rewrite; see the targetSdk note in app/build.gradle for
             why the type is the thing pinning that version. -->
        <service
            android:name=".push.PushService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <!-- The single Activity; everything above it is Compose. -->
        <activity
            android:name=".ui.WlwdwActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.Wlwdw">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
