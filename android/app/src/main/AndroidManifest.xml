<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    android:versionCode="1"
    android:versionName="1.0">

    <!-- Location: GPS + network geolocation (Baidu location SDK). The app is a
         tracker; ACCESS_BACKGROUND_LOCATION is requested at runtime (Android
         10+) when the user starts continuous location, so fixes keep flowing
         while the screen is off. -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION" />
    <!-- Network geolocation (wifi/network state) + internet to reach the
         server (HTTPS trail upload / message pull) and the MQTT broker (WSS). -->
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_STATE" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Realtime MQTT push foreground service + its notifications. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.VIBRATE" />

    <application
        android:name=".LocationApplication"
        android:allowBackup="false"
        android:icon="@drawable/ic_launcher"
        android:label="@string/app_name"
        android:theme="@style/AppTheme">

        <uses-library
            android:name="org.apache.http.legacy"
            android:required="false" />

        <service
            android:name=".MqttPushService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <service
            android:name="com.baidu.location.f"
            android:enabled="true"
            android:process=":remote"></service>

        <!-- Baidu Map/Location API key, injected at build time from the
             untracked android/gradle-local.properties (see
             gradle-local.properties.example). Never commit a real key here. -->
        <meta-data
            android:name="com.baidu.lbsapi.API_KEY"
            android:value="${BAIDU_MAP_AK}" />

        <activity
            android:name=".MapActivity"
            android:label="@string/app_name"></activity>
        <activity
            android:name=".LocationActivity"
            android:label="@string/app_name"></activity>
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name=".SettingsActivity"
            android:label="@string/title_activity_settings"></activity>
        <activity
            android:name=".MessageActivity"
            android:label="@string/title_activity_message"></activity>
    </application>

</manifest>