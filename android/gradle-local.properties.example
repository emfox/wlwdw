# Local secrets for Android build (NOT committed; see .gitignore).
#
# Copy this file to gradle-local.properties in this directory and fill in a
# real value, matching the server-side MQTT_DEVICE_SHARED_SECRET in the wlwdw
# app (.env / .env.local). The backend's /mqtt/auth callback uses that secret
# to validate every non-server (device) MQTT client, so this must be identical
# across Android and server.
#
#   cp gradle-local.properties.example gradle-local.properties
MQTT_DEVICE_SHARED_SECRET=change_me_same_as_server_env
