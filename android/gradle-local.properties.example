# Local secrets for Android build (NOT committed; see .gitignore).
#
# Copy this file to gradle-local.properties in this directory and fill in real
# values:
#
#   cp gradle-local.properties.example gradle-local.properties
#
# MQTT_DEVICE_SHARED_SECRET
#   Must match the server-side MQTT_DEVICE_SHARED_SECRET in the wlwdw app
#   (.env). The backend's /mqtt/auth callback validates every non-server
#   (device) MQTT client with it, so it must be identical across Android and
#   server.
#
# RELEASE_KEYSTORE_PATH / RELEASE_KEY_ALIAS / RELEASE_STORE_PASSWORD /
# RELEASE_KEY_PASSWORD
#   Release signing config, resolved relative to android/. The keystore file
#   (android/keystore/release.jks) is gitignored and must be backed up
#   separately — it signs every distributed APK. If these are absent, release
#   builds are left unsigned.
#
# TIANDITU_MAP_KEY
#   Optional, and normally absent. The Tianditu JS API key the bundled map shell
#   boots with; if unset, the build falls back to the key the website already
#   uses. That key is printed in the page source of /main/tianditu, so it is not
#   a secret and there is nothing to fill in here. Set it only to move the app
#   onto a different Tianditu account — the line at the bottom shows the shape.
#
#   The key is a "browser" type: Tianditu validates it on the User-Agent, not on
#   the Referer, which is why a WebView can use it and why neither a SHA-1 nor a
#   package name is involved. Those two belong to the Android SDK key type,
#   which this app does not use.
MQTT_DEVICE_SHARED_SECRET=change_me_same_as_server_env
RELEASE_KEYSTORE_PATH=keystore/release.jks
RELEASE_KEY_ALIAS=release
RELEASE_STORE_PASSWORD=change_me_release_store_password
RELEASE_KEY_PASSWORD=change_me_release_key_password

# Only if the app should use a Tianditu account other than the website's.
#TIANDITU_MAP_KEY=
