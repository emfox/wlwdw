# Test environment overrides (.env is loaded first if present, but tests must
# also run on a fresh clone where no .env exists yet -- so everything that
# config/packages/*.yaml reads via %env()% is defined here).
# A SQLite file DB is used so tests run without a MySQL server.
APP_ENV=test
APP_SECRET=test-secret
TRUSTED_PROXIES=127.0.0.0/8
DATABASE_URL="sqlite:///%kernel.project_dir%/var/test.db"

# Twig globals only carry placeholder keys in tests.
GOOGLE_MAP_API_KEY=test-google-key
BAIDU_MAP_API_KEY=test-baidu-key

# services.yaml always builds MqttPublisher from these env vars, but in tests
# the publisher is swapped for a spy (never contacted), so placeholders are
# fine. compose.yml overrides MQTT_BROKER_HOST in the docker stack.
MQTT_BROKER_HOST=127.0.0.1
MQTT_BROKER_PORT=1883

# Fixed test credentials for MqttAuthControllerTest (no broker needed).
MQTT_SERVER_USER=mqtt-server
MQTT_SERVER_PASSWORD=mqtt-server-test-pass
MQTT_DEVICE_SHARED_SECRET=mqtt-device-test-secret
